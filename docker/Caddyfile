# Reverse proxy in front of the Claude Science daemon.
#
# Why this exists: when a session expires (most often the one-time daemon
# restart on first sign-in) the daemon answers every request with 401 and its
# own "session has expired" page. That page confuses users. This proxy catches
# the 401 and sends the browser through /__cs_auth, which mints a fresh login
# link and drops them straight back into the app. They never see the raw page.
#
# Ports (all set by the entrypoint):
#   CLAUDE_SCIENCE_PORT  public port the browser uses (this proxy listens here)
#   CS_DAEMON_PORT       the daemon's UI port, internal to the container
#   CS_MINT_PORT         the tiny mint server (launcher.sh), internal

{
	admin off
	auto_https off
	persist_config off
}

:{$CLAUDE_SCIENCE_PORT:8000} {
	# The mint endpoint: creates a fresh single-use login link and 302s to it.
	handle /__cs_auth* {
		reverse_proxy 127.0.0.1:{$CS_MINT_PORT:47101}
	}

	# Everything else goes to the daemon. If the daemon says 401 to a browser
	# navigation (HTML), auto-redirect through the mint endpoint to sign back in.
	# API/XHR 401s (Content-Type application/json) pass through untouched so the
	# app's own code still handles them.
	handle {
		reverse_proxy 127.0.0.1:{$CS_DAEMON_PORT:47100} {
			# Present every request to the daemon as same-origin. The daemon's
			# CSRF gate only accepts WebSocket upgrades whose Origin matches its
			# own address (its --allow-origin flag does not cover WebSockets in
			# this build), so rewrite the browser's Origin to the daemon's. This
			# is the "same-origin reverse proxy" the daemon's own help suggests;
			# the localhost publish + the session token stay as the real gates.
			header_up Origin http://127.0.0.1:{$CS_DAEMON_PORT:47100}

			@expired {
				status 401
				header Content-Type text/html*
			}
			# On an expired-session page, hand the request to the mint server
			# instead, which 302s the browser to a fresh /?nonce=... login.
			handle_response @expired {
				rewrite * /__cs_auth
				reverse_proxy 127.0.0.1:{$CS_MINT_PORT:47101}
			}
		}
	}

	# The daemon is briefly unreachable while it restarts (e.g. right after your
	# first sign-in). Show a self-refreshing page instead of a proxy error.
	handle_errors {
		respond "<!doctype html><meta charset=utf-8><meta http-equiv=refresh content=2><title>Reconnecting</title><body style='font:15px/1.6 system-ui,sans-serif;text-align:center;padding:4rem 1rem;color:#333'><h2>Reconnecting...</h2><p>Claude Science is starting up. This page refreshes on its own.</p>" 200
	}
}
