# Copy to .env and adjust. All variables are optional - defaults are sane.

# Image to run (set to your Docker Hub repo to skip local builds)
#CLAUDE_SCIENCE_IMAGE=yourname/claude-science:latest

# Pin a specific upstream build instead of "latest" (build-time only)
#CLAUDE_SCIENCE_URL=https://downloads.claude.ai/claude-science/latest/linux-x64

# Host ports (web UI / sandboxed HTML previews)
#CLAUDE_SCIENCE_PORT=8000
#CLAUDE_SCIENCE_SANDBOX_PORT=8001

# Let the daemon self-update inside the container (not recommended; pull a
# new image instead)
#CLAUDE_SCIENCE_AUTO_UPDATE=false

# Serve under a URL prefix behind a reverse proxy, e.g. /science
#CLAUDE_SCIENCE_BASE_PATH=

# Extra browser Origins allowed through the CSRF gate (space-separated),
# e.g. https://science.example.com
#CLAUDE_SCIENCE_ALLOW_ORIGINS=

# DANGER ZONE ----------------------------------------------------------------
# Disable the daemon's internal sandbox (the container becomes the only
# isolation boundary). Enable only if the sandbox fails to start in Docker.
#CLAUDE_SCIENCE_DISABLE_SANDBOX=false

# Auto-approve every permission prompt (code execution, network, files).
# Never enable on data or prompts you did not write yourself.
#CLAUDE_SCIENCE_SKIP_APPROVALS=false

# Any extra `claude-science serve` flags
#CLAUDE_SCIENCE_EXTRA_ARGS=
